// kql.lark — KQLBridge Grammar
// ============================================================
// LOCKED FILE — Human-designed. Agent MUST NEVER modify this.
// ============================================================
// Version: 0.1.1
// Covers: 14 v0.1 operators + between + summarize-by-alias
// Parser: Earley (handles ambiguous KQL constructs safely)

// ─── Entry Point ────────────────────────────────────────────

start: let_stmt* table_expr ("|" pipe_op)*

// ─── Let / CTE ──────────────────────────────────────────────

let_stmt: "let" NAME "=" (table_ref_expr | expr | timespan) ";"

table_ref_expr: NAME ("|" pipe_op)*

// ─── Table ──────────────────────────────────────────────────

table_expr: NAME

// ─── Pipe Operators ─────────────────────────────────────────

pipe_op: where_op
       | project_op
       | project_away_op
       | project_rename_op
       | project_reorder_op
       | project_keep_op
       | summarize_op
       | order_op
       | take_op
       | distinct_op
       | extend_op
       | join_op
       | lookup_op
       | union_op
       | count_op
       | serialize_op

lookup_op: "lookup" join_body "on" join_keys

// ─── where ──────────────────────────────────────────────────

where_op: "where" bool_expr

// ─── project ────────────────────────────────────────────────

project_op: "project" project_list
project_away_op: "project-away" name_list
project_rename_op: "project-rename" rename_list
project_reorder_op: "project-reorder" name_list
project_keep_op: "project-keep" name_list

name_list: NAME ("," NAME)*
rename_list: rename_item ("," rename_item)*
rename_item: NAME "=" NAME

// ─── summarize ──────────────────────────────────────────────

summarize_op: "summarize" agg_list ("by" groupby_list)?

agg_list: agg_item ("," agg_item)*

agg_item: NAME "=" agg_func   -> named_agg
        | agg_func             -> anon_agg

agg_func: "count" "()"                         -> agg_count
        | "sumif"    "(" expr "," bool_expr ")" -> agg_sumif
        | "avgif"    "(" expr "," bool_expr ")" -> agg_avgif
        | "maxif"    "(" expr "," bool_expr ")" -> agg_maxif
        | "minif"    "(" expr "," bool_expr ")" -> agg_minif
        | "dcountif" "(" expr "," bool_expr ")" -> agg_dcountif
        | "sum"   "(" expr ")"                  -> agg_sum
        | "avg"   "(" expr ")"                  -> agg_avg
        | "min"   "(" expr ")"                  -> agg_min
        | "max"   "(" expr ")"                  -> agg_max
        | "dcount" "(" expr ")"                 -> agg_dcount
        | "countif" "(" bool_expr ")"           -> agg_countif
        | "bin"   "(" expr "," timespan ")"     -> agg_bin
        | "percentile" "(" expr "," expr ")"    -> agg_percentile
        | "make_list" "(" expr ")"              -> agg_make_list
        | "make_set" "(" expr ")"               -> agg_make_set
        | "any" "(" expr ")"                    -> agg_any
        | "take_any" "(" expr ")"               -> agg_any
        | "arg_max" "(" expr "," (NAME | "*" | expr_list) ")" -> agg_arg_max
        | "arg_min" "(" expr "," (NAME | "*" | expr_list) ")" -> agg_arg_min
        | "stdev" "(" expr ")"                  -> agg_stdev

expr_list: expr ("," expr)*

groupby_list: groupby_item ("," groupby_item)*
groupby_item: NAME "=" groupby_expr             -> named_group
            | groupby_expr                      -> plain_group

groupby_expr: "bin" "(" expr "," timespan ")"  -> bin_group_expr
            | expr                              -> plain_group_expr

// ─── order by / sort by ─────────────────────────────────────

order_op: ("order" | "sort") "by" order_list

order_list: order_item ("," order_item)*
order_item: expr ORDER_DIR?

ORDER_DIR: "asc" | "desc"

// ─── take / limit ───────────────────────────────────────────

take_op: ("take" | "limit") INT

// ─── distinct ───────────────────────────────────────────────

distinct_op: "distinct" col_list
           | "distinct" "*"

// ─── extend ─────────────────────────────────────────────────

extend_op: "extend" assign_list

assign_list: assign_item ("," assign_item)*
assign_item: NAME "=" assign_val
assign_val: expr COMP_OP expr   -> assign_comparison
          | expr                 -> assign_expr

// ─── join ───────────────────────────────────────────────────

join_op: "join" join_kind? join_body "on" join_keys

join_body: "(" table_ref_expr ")"
         | NAME

join_kind: "kind" "=" JOIN_KIND_VAL

JOIN_KIND_VAL: "inner" | "leftouter" | "rightouter" | "fullouter"

join_keys: join_key_item ("," join_key_item)*
join_key_item: NAME
             | "$left." NAME "==" "$right." NAME

// ─── union ──────────────────────────────────────────────────

union_op: "union" union_tables

union_tables: union_item ("," union_item)*
union_item: NAME              -> union_table_name
          | "(" table_ref_expr ")"  -> union_table_subquery

// ─── count ──────────────────────────────────────────────────

count_op: "count"

// ─── serialize ──────────────────────────────────────────────

serialize_op: "serialize" assign_list?

// ─── Expressions ─────────────────────────────────────────────

bool_expr: bool_expr LOGICAL_OP bool_expr  -> logical
         | "not" bool_expr                       -> negation
         | "(" bool_expr ")"                     -> paren_bool
         | comparison

comparison: expr COMP_OP expr
          | expr "in" "(" value_list ")"         -> in_expr
          | expr "!in" "(" value_list ")"        -> not_in_expr
          | expr "in~" "(" value_list ")"        -> in_ci_expr
          | expr "!in~" "(" value_list ")"       -> not_in_ci_expr
          | expr "in" "(" table_ref_expr ")"    -> subquery_in_expr
          | expr "!in" "(" table_ref_expr ")"   -> subquery_not_in_expr
          | expr "in~" "(" table_ref_expr ")"    -> subquery_in_ci_expr
          | expr "!in~" "(" table_ref_expr ")"   -> subquery_not_in_ci_expr
          | expr "has" STRING                    -> has_expr
          | expr "!has" STRING                   -> not_has_expr
          | expr "contains" STRING               -> contains_expr
          | expr "!contains" STRING              -> not_contains_expr
          | expr "startswith" STRING             -> startswith_expr
          | expr "!startswith" STRING            -> not_startswith_expr
          | expr "endswith" STRING               -> endswith_expr
          | expr "!endswith" STRING              -> not_endswith_expr
          | expr "matches" "regex" expr          -> regex_expr
          | expr "!matches" "regex" expr         -> not_regex_expr
          | "isnotnull"  "(" expr ")"            -> isnotnull_expr
          | "isnotempty" "(" expr ")"            -> isnotempty_expr
          | "isempty"    "(" expr ")"            -> isempty_expr
          | "isnull" "(" expr ")"                -> isnull_expr
          | expr "has_any" "(" value_list ")"    -> has_any_expr
          | expr "hasany" "(" value_list ")"     -> has_any_expr
          | expr "between" "(" expr ".." expr ")" -> between_expr

COMP_OP: "==" | "!=" | "<=" | ">=" | "<" | ">" | "=~"
LOGICAL_OP: "and" | "or"

value_list: literal ("," literal)*

// ─── Expressions (arithmetic / function calls) ────────────────

expr: expr "+" term   -> add
    | expr "-" term   -> sub
    | term

term: term "*" factor -> mul
    | term "/" factor -> div
    | factor

?factor: primary
       | "-" primary                    -> unary_minus
       | primary "[" (INT | STRING) "]" -> indexed_access
       | factor "." NAME                -> property_access

?primary: iff_call
        | ago_expr
        | bin_expr
        | func_call
        | NAME            -> column_ref
        | literal
        | "(" expr ")"   -> paren_expr
        | bool_expr      -> bool_as_expr

ago_expr  : "ago" "(" timespan ")"
bin_expr  : "bin" "(" expr "," timespan ")"

func_call : NAME "(" (expr ("," expr)*)? ")"

// iff(condition, true_val, false_val) — condition is a bool_expr
iff_call: "iff" "(" bool_expr "," expr "," expr ")"

// ─── Literals ────────────────────────────────────────────────

literal: STRING    -> string_lit
       | FLOAT     -> float_lit
       | INT       -> int_lit
       | BOOL      -> bool_lit
       | DATETIME  -> datetime_lit

BOOL: "true" | "false"
DATETIME: /datetime\([^)]+\)/

// ─── Timespan ────────────────────────────────────────────────

timespan: INT TIMEUNIT

TIMEUNIT: "d" | "h" | "m" | "s" | "ms" | "us" | "ns"

// ─── Helpers ─────────────────────────────────────────────────

col_list: NAME ("," NAME)*
project_list: project_item ("," project_item)*
project_item: NAME "=" expr   -> project_alias
            | expr             -> project_col

// ─── Terminals ───────────────────────────────────────────────

NAME   : /[a-zA-Z_][a-zA-Z0-9_.]*/ 
STRING : /@?\"[^\"]*\"/ | /@?\'[^\']*\'/
INT    : /[0-9]+/
FLOAT  : /[0-9]*\.[0-9]+([eE][+-]?[0-9]+)?/ | /[0-9]+[eE][+-]?[0-9]+/

%ignore /\s+/
%ignore /\/\/[^\n]*/    // line comments
